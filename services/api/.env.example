NODE_ENV=
PORT=
DATABASE_URL=
# 64 hex chars (openssl rand -hex 32). The API refuses to start without it.
IDENTITY_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_VERIFICATION_MODE=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_ALLOWED_ALGORITHMS=
SUPABASE_GATE_DOCTOR_EMAIL=
SUPABASE_GATE_PATIENT_EMAIL=
SUPABASE_GATE_PASSWORD=
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
MODEL_ROUTE_ANALYST_1=ag/gemini-3.8-flash-high
MODEL_ROUTE_ANALYST_2=ag/gemini-3.8-flash-high
MODEL_ROUTE_JUDGE=ag/gemini-3.8-flash-high
MODEL_ROUTE_OCR=ag/gemini-3.8-flash-high
# Comma-separated web origins; required when NODE_ENV=production. ./run.sh sets it for local dev.
CORS_ORIGINS=
# Optional Postgres pool sizes. Supabase session mode allows 15 connections across api + worker.
DB_POOL_MAX=
QUEUE_POOL_MAX=
SEED_DEMO_PASSWORD=
SEED_API_BASE_URL=
