{
  "name": "@clinix/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./crypto": "./src/crypto.ts",
    "./safety": "./src/safety/evaluator.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth:live": "node gate-supabase-auth.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "tsx src/check-db.ts"
  },
  "dependencies": {
    "@clinix/schemas": "*",
    "@fastify/cors": "^11.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.13",
    "pg-boss": "^12.37.0",
    "postgres": "^3.4.7",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
