{
  "name": "clinix",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,worker -c green,blue,yellow \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:web": "npm run dev --workspace @clinix/web",
    "dev:api": "npm run dev --workspace @clinix/api",
    "dev:worker": "npm run dev --workspace @clinix/worker",
    "build": "npm run build --workspace @clinix/web",
    "lint": "npm run lint --workspace @clinix/web",
    "test": "npm run test --workspace @clinix/web && npm run test --workspace @clinix/api && npm run test --workspace @clinix/worker",
    "test:browser": "npm run test:browser --workspace @clinix/web",
    "typecheck": "npm run typecheck --workspace @clinix/web && npm run typecheck --workspace @clinix/api && npm run typecheck --workspace @clinix/worker",
    "db:generate": "npm run db:generate --workspace @clinix/api",
    "db:migrate": "npm run db:migrate --workspace @clinix/api",
    "db:check": "npm run db:check --workspace @clinix/api",
    "seed": "npm run seed --workspace @clinix/api",
    "build:android": "npm run build:android --workspace @clinix/mobile"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.5",
    "vitest": "^5.0.5"
  }
}
