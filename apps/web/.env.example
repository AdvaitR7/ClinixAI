# Local dev: use ./run.sh (web :12455, API :12456); it overrides these two URLs and sets CORS_ORIGINS.
# Plain `npm run dev` uses web :3000 and the API PORT from services/api/.env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_REDIRECT_BASE_URL=http://localhost:3000
